---
interface Link {
	label: string;
	href: string;
}

interface Props {
	name: string;
	heroLine: string;
	proof: string;
	primaryCta: Link;
	links: Link[];
}

const { name, heroLine, proof, primaryCta, links } = Astro.props;
---

<header class="hero">
	<h1 class="name">{name}</h1>
	<p class="hero-line">{heroLine}</p>
	<p class="lede">{proof}</p>
	<div class="actions">
		<a class="button" href={primaryCta.href} rel="noreferrer">{primaryCta.label}</a>
		<ul class="hero-links">
			{
				links.map((link) => (
					<li>
						<a href={link.href} rel="noreferrer">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</header>
