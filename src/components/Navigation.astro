---
// 'projects' marks the Projects page itself; 'work' marks a case study inside it.
interface Props { current?: 'projects' | 'work' }
const { current } = Astro.props;
const root = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<header class="site-nav">
  <a class="wordmark" href={root} aria-label="Jacob Kambour — home">Jacob Kambour<span>FINANCE & ANALYTICS</span></a>
  <button class="menu-toggle" type="button" aria-controls="site-menu" aria-expanded="false" hidden><span>Menu</span><span class="menu-icon" aria-hidden="true">＋</span></button>
  <nav class="nav-links" id="site-menu" aria-label="Main navigation">
    <a class="roll-link" href={`${root}projects/`} aria-current={current === 'projects' ? 'page' : current === 'work' ? 'true' : undefined}><span>Projects</span><span aria-hidden="true">Projects</span></a>
    <a class="roll-link" href={`${root}#experience`}><span>Experience</span><span aria-hidden="true">Experience</span></a>
  </nav>
  <a class="button button-light nav-contact" href="mailto:jkambour@gmail.com">Get in touch <span aria-hidden="true">↗</span></a>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-nav');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = header?.querySelector<HTMLElement>('#site-menu');
  if (header && toggle && menu) {
    const mobile = window.matchMedia('(max-width: 760px)');
    const contact = header.querySelector<HTMLElement>('.nav-contact');
    let compact = false;
    let scrolled = false;
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector('span')!.textContent = open ? 'Close' : 'Menu';
      menu.hidden = compact && !open;
      if (contact) contact.hidden = compact && !open;
      header.classList.toggle('menu-open', compact && open);
    };
    const sync = () => {
      // Separate thresholds prevent flickering near the collapse point.
      scrolled = window.scrollY > (scrolled ? 48 : 120);
      const nextCompact = mobile.matches || scrolled;
      header.classList.toggle('is-scrolled', scrolled);
      header.classList.toggle('is-compact', nextCompact);
      if (compact !== nextCompact) {
        const restoreFocus = header.contains(document.activeElement);
        compact = nextCompact;
        toggle.hidden = !compact;
        setOpen(false);
        if (restoreFocus) (compact ? toggle : header.querySelector<HTMLAnchorElement>('.wordmark'))?.focus({ preventScroll: true });
      } else toggle.hidden = !compact;
    };
    sync();
    setOpen(false);
    let framePending = false;
    window.addEventListener('scroll', () => {
      if (framePending) return;
      framePending = true;
      requestAnimationFrame(() => { sync(); framePending = false; });
    }, { passive: true });
    mobile.addEventListener('change', sync);
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) setOpen(false); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); } });
    document.addEventListener('click', (event) => { if (!header.contains(event.target as Node)) setOpen(false); });
  }
</script>
