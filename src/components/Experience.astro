---
import type { CollectionEntry } from 'astro:content';

interface Props {
	roles: CollectionEntry<'experience'>[];
}

const { roles } = Astro.props;
---

<section class="section" id="experience" aria-labelledby="experience-heading">
	<h2 class="section-title" id="experience-heading">Experience</h2>
	{
		roles.map((role) => (
			<article class="role">
				<h3 class="role-title">
					{role.data.title}, {role.data.org}
				</h3>
				{role.data.dates && <p class="meta">{role.data.dates}</p>}
				<ul>
					{role.data.bullets.map((bullet) => (
						<li>{bullet}</li>
					))}
				</ul>
			</article>
		))
	}
</section>
