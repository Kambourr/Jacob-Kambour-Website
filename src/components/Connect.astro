---
interface Link {
	label: string;
	href: string;
}

interface Props {
	links: Link[];
}

const { links } = Astro.props;
---

<section class="section" id="connect" aria-labelledby="connect-heading">
	<h2 class="section-title" id="connect-heading">Connect</h2>
	<ul class="connect-list">
		{
			links.map((link) => (
				<li>
					<a href={link.href} rel="noreferrer">
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</section>
