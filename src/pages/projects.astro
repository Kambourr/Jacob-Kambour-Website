---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ProjectProcess from '../components/ProjectProcess.astro';
import ContactFooter from '../components/ContactFooter.astro';
import '../styles/scrollcraft-portfolio.css';
const work = (await getCollection('work')).toSorted((a, b) => a.data.order - b.data.order);
const root = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const projectImages = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg,jpeg,webp}', { eager: true });
---
<BaseLayout title="Projects — Jacob Kambour" description="Jacob Kambour's independent projects in financial modeling, data analysis, and applied AI, built from public data.">
  <Navigation current="projects" />
  <main id="main">
    <section class="projects-hero" aria-labelledby="projects-title">
      <div class="page-width projects-hero-grid">
        <div>
          <p class="eyebrow light-label"><span>( PROJECTS )</span><span aria-hidden="true">↘</span></p>
          <h1 id="projects-title">Projects</h1>
        </div>
        <div class="projects-hero-copy">
          <p>Personal projects in financial modeling, data analysis, and AI. Each one has a full case study.</p>
          <p class="projects-independence">Independent projects using public data or illustrative numbers. Not affiliated with or endorsed by Tesla or Applied Materials.</p>
          <nav class="projects-index" aria-label="Projects on this page">
            {work.map((item) => <a href={`#${item.id}`}><span>{item.data.title}</span><span aria-hidden="true">↘</span></a>)}
          </nav>
        </div>
      </div>
    </section>

    <section class="selected-work projects-list section-pad page-width" aria-label="Project details">
      {work.map((item, index) => {
        const image = projectImages[`../assets/${item.data.image}`]?.default;
        const projectHref = item.data.caseStudyPath ? `${root}${item.data.caseStudyPath}` : item.data.href;
        return (
        <article class="project" id={item.id} aria-labelledby={`project-${item.id}`}>
          {image && <a href={projectHref} target="_blank" rel="noopener noreferrer" class="project-stage" aria-label={`Read the ${item.data.title} case study`}>
            <div class="project-stage-top"><span class="eyebrow">( {String(index + 1).padStart(2, '0')} / INDEPENDENT PROJECT )</span><span class="project-live">{item.data.caseStudyPath ? 'READ CASE STUDY' : item.data.hrefLabel} <span aria-hidden="true">↗</span></span></div>
            <div class="project-screenshot"><Image src={image} alt={item.data.imageAlt} widths={[720, 1080, 1440]} sizes="(max-width: 760px) 85vw, 75vw" loading={index === 0 ? 'eager' : 'lazy'} /></div>
            <div class="project-stage-bottom"><span>{item.data.title}</span><span class="round-arrow" aria-hidden="true">↗</span></div>
          </a>}
          {item.id === 'tesla-fpa-agent' && <ProjectProcess />}
          <div class="project-details">
            <div><p class="eyebrow project-tags">{item.data.tags.join(' / ')}</p><h2 id={`project-${item.id}`}>{item.data.title}</h2></div>
            <div>
              <p>{item.data.summary}</p>
              <div class="project-links">
                {projectHref && <a class="text-link" href={projectHref} target="_blank" rel="noopener noreferrer">{item.data.caseStudyPath ? 'Read case study' : 'Explore project'} <span aria-hidden="true">↗</span></a>}
                {item.data.href && item.data.hrefLabel && <a class="text-link subtle-link" href={item.data.href} target="_blank" rel="noopener noreferrer">{item.data.hrefLabel} <span aria-hidden="true">↗</span></a>}
              </div>
            </div>
          </div>
        </article>
      ); })}
      <div class="work-note"><span aria-hidden="true">↳</span><p>More projects will be added here.</p><a href="https://github.com/Kambourr" target="_blank" rel="noopener noreferrer">Follow on GitHub <span aria-hidden="true">↗</span></a></div>
    </section>

    <ContactFooter />
  </main>
</BaseLayout>
