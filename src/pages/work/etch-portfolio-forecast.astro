  <script>
    import '../../vendor/scrollcraft/scrollcraft.js';
    const peak = document.querySelector<HTMLElement>('.etp-peak');
    const stage = peak?.querySelector<HTMLElement>('.etp-peak-stage');
    const items = Array.from(peak?.querySelectorAll<HTMLElement>('.etp-steps li') ?? []);
    const panels = Array.from(peak?.querySelectorAll<HTMLElement>('.etp-panel') ?? []);
    const live = window.matchMedia('(min-width: 861px) and (min-height: 640px) and (prefers-reduced-motion: no-preference)');
    // Step boundaries in act progress for six steps.
    const bounds = [0, 0.14, 0.3, 0.46, 0.62, 0.78];
    let frame = 0;
    let visible = false;
    let current = -1;
    const render = () => {
      frame = 0;
      if (!peak || !stage || !peak.classList.contains('is-live')) return;
      const p = parseFloat(peak.style.getPropertyValue('--sc-p')) || 0;
      let step = 0;
      bounds.forEach((b, i) => { if (p >= b) step = i; });
      stage.style.setProperty('--etp-p', p.toFixed(4));
      if (step !== current) {
        current = step;
        stage.dataset.step = String(step);
        items.forEach((li, i) => li.classList.toggle('is-active', i === step));
        panels.forEach((pn, i) => pn.classList.toggle('is-active', i === step));
      }
      stage.dataset.scVerifyState = `${step}|${p.toFixed(2)}`;
      if (visible) frame = requestAnimationFrame(render);
    };
    // The layout is chosen once, before the engine collects acts. A static
    // composition becomes a flow act so the engine never tries to pin it.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const tabsSection = document.querySelector<HTMLElement>('.etp-tabs');
    if (reduce.matches && tabsSection) tabsSection.setAttribute('data-sc-act', 'flow');
    const startLive = live.matches;
    const sync = () => {
      if (!peak || !stage) return;
      const on = startLive && live.matches;
      peak.classList.toggle('is-live', on);
      if (!on) {
        stage.dataset.step = 'all';
        stage.removeAttribute('data-sc-verify-state');
        items.forEach((li) => li.classList.remove('is-active'));
        panels.forEach((pn) => pn.classList.remove('is-active'));
        current = -1;
      } else if (current < 0) {
        current = 0;
        items[0]?.classList.add('is-active');
        panels[0]?.classList.add('is-active');
      }
    };
    if (peak && !startLive) peak.setAttribute('data-sc-act', 'flow');
    sync();
    const craft = (window as unknown as { ScrollCraft: { mount: (root: HTMLElement) => void } }).ScrollCraft;
    const main = document.querySelector<HTMLElement>('main');
    if (main && craft) craft.mount(main);
    live.addEventListener('change', () => { sync(); window.dispatchEvent(new Event('resize')); });
    if (peak && 'IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        if (visible && !frame) frame = requestAnimationFrame(render);
      }).observe(peak);
    }
  </script>
