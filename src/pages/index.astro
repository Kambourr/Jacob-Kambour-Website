---
/**
 * Homepage: one-screen recruiter page (replaced the Stokt-inspired homepage, Nov 11 2026).
 * Everything a recruiter needs fills the first screen; a role or degree opens on click
 * for the detail. The Tesla FP&A revenue-bridge band that used to sit below the fold
 * was removed on Nov 12 2026 at Jacob's request. The old /v2/ draft URL redirects here
 * (astro.config.mjs).
 */
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/jacob-kambour.jpg';

const site = await getEntry('site', 'home');
if (!site) throw new Error('Missing home content');
const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const work = (await getCollection('work')).toSorted(byOrder);
const roles = (await getCollection('experience')).toSorted(byOrder);
const degrees = (await getCollection('education')).toSorted(byOrder);
const root = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg,jpeg,webp}', { eager: true });

const linkedin = site.data.contact.find((c) => c.href.includes('linkedin'))?.href;
const github = site.data.profileLinks.find((l) => l.label === 'GitHub')?.href;
const monogram: Record<string, string> = { tesla: 'T', blendid: 'B' };

---
<BaseLayout title="Jacob Kambour — FP&A, Forecasting, and Financial Modeling" description="Jacob Kambour: current MS in Finance and Analytics student at Santa Clara University, Tesla Sales and Delivery Advisor, and builder of forecasting tools: a Tesla FP&A agent, a delivery center estimator and an Etch spend forecast builder.">
  <main id="main" class="v2">
    <div class="screen">
    <div class="top">
      <header class="intro">
        <div class="id">
          <span class="portrait"><Image src={portrait} alt="Jacob Kambour" widths={[160, 320, 480]} sizes="148px" loading="eager" fetchpriority="high" /></span>
          <div>
            <h1>Jacob Kambour</h1>
            <p class="role">FP&amp;A, forecasting, and financial modeling</p>
            <nav class="links" aria-label="Contact and profiles">
              <a href="mailto:jkambour@gmail.com">Email</a>
              {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>}
              {github && <a href={github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a>}
              <a href={`${root}projects/`}>Project details</a>
            </nav>
          </div>
        </div>
      </header>

      <p class="lede">Current MS in Finance and Analytics student at Santa Clara University, started during senior year of the BS. Tesla advisor ranked third in the region for Q3 deliveries, with over $2 million in revenue closed in two weeks, and Supercharged Advisor of the Month for Burlingame. Please explore my projects below.</p>

      <section class="col" id="experience" aria-labelledby="edu-title">
        <h2 id="edu-title">Education</h2>
        <div class="rows edu">
          {degrees.map((d) => (
            <div class="row static">
              <span class="mark" aria-hidden="true">SCU</span>
              <span class="row-text">
                <span class="row-title">{d.data.credential}</span>
                <span class="row-sub">{d.data.school}{d.data.dates && <> · {d.data.dates}</>}</span>
                {(d.data.accent || d.data.highlights) && (
                  <span class="chips">
                    {d.data.accent && <span class="chip accent">{d.data.accent}</span>}
                    {d.data.highlights?.map((h) => <span class="chip">{h}</span>)}
                  </span>
                )}
              </span>
            </div>
          ))}
        </div>
        <h2 id="exp-title" class="sub-h">Experience</h2>
        <div class="rows">
          {roles.map((role) => (
            <details class="row" name="v2-detail">
              <summary>
                <span class="mark" aria-hidden="true">{monogram[role.id] ?? role.data.org[0]}</span>
                <span class="row-text"><span class="row-title">{role.data.org}</span><span class="row-sub">{role.data.title}{role.data.dates && <> · {role.data.dates}</>}</span></span>
                <span class="chev" aria-hidden="true">+</span>
              </summary>
              <ul>{role.data.bullets.map((b) => <li>{b}</li>)}</ul>
            </details>
          ))}
        </div>
      </section>

      <section class="col" aria-labelledby="proj-title">
        <h2 id="proj-title">Projects</h2>
        <div class="projects">
          {work.map((item) => {
            const img = images[`../assets/${item.data.image}`]?.default;
            const href = item.data.caseStudyPath ? `${root}${item.data.caseStudyPath}` : item.data.href ?? `${root}projects/`;
            return (
              <a class="proj-card" href={href}>
                {img && <span class="thumb"><Image src={img} alt="" widths={[240, 480]} sizes="200px" loading="eager" /></span>}
                <span class="project-text">
                  <span class="tagline">{item.data.tagline}</span>
                  <span class="row-title">{item.data.title} <span aria-hidden="true">→</span></span>
                </span>
              </a>
            );
          })}
        </div>
        <p class="note">Independent projects using public data or illustrative numbers. Not affiliated with or endorsed by Tesla or Applied Materials.</p>
      </section>
    </div>
    </div>

  </main>
</BaseLayout>

<style>
  .v2 {
    --cream: #f2f1ea; --ink: #102d30; --soft: #526668; --line: #ccd4d0;
    --petrol: #092f33; --deep: #071e22; --mint: #9bd4c2; --ice: #c8e6dc;
    --amber: #e3b062; --up: #acdfc9; --t-line: #1d4a4e;
    background: var(--cream); color: var(--ink);
  }
  /* The page is one screen of recruiter content. */
  .screen { min-height: 100svh; display: flex; flex-direction: column; }
  .screen > .top { margin-block: auto; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* ---------- top: identity, experience, projects ---------- */
  .top {
    width: min(1180px, calc(100% - 96px)); margin-inline: auto; padding: clamp(22px, 3.8vh, 52px) 0 clamp(16px, 2.4vh, 32px);
    display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(48px, 7vw, 112px); row-gap: clamp(18px, 2.8vh, 32px); align-items: start;
  }
  .id { display: flex; align-items: center; gap: clamp(16px, 2vw, 26px); }
  .portrait { flex: none; width: clamp(96px, 10vw, 148px); aspect-ratio: 1; display: block; overflow: hidden; border-radius: 18px; border: 1px solid var(--line); background: var(--petrol); box-shadow: 0 14px 36px #092f3326; }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 24%; }
  h1 { margin-top: 0; font-size: clamp(44px, 5.2vw, 68px); line-height: 1; letter-spacing: -.045em; }
  .role { margin-top: 10px; font-size: 19px; letter-spacing: -.02em; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 16px; font-size: 15px; }
  .links a, .proj-card .row-title, .row-title { text-decoration: underline; text-decoration-color: #102d3055; text-underline-offset: 4px; text-decoration-thickness: 1px; transition: text-decoration-color .2s, color .2s; }
  .links a:hover { text-decoration-color: currentColor; }
  .lede { align-self: center; max-width: 54ch; font-size: 17px; line-height: 1.55; color: var(--ink); padding-bottom: 4px; border-left: 2px solid var(--mint); padding-left: 18px; }

  .col h2 { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--soft); margin-bottom: 10px; }
  .col .sub-h { margin-top: clamp(16px, 2.4vh, 24px); }
  .edu .row-title { font-size: 18px; }
  .edu .row.static { align-items: start; padding-block: 8px; }
  .edu .mark { margin-top: 3px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .chip { padding: 3px 9px; border-radius: 6px; border: 1px solid var(--line); background: #ffffff; font-family: var(--font-mono); font-size: 11px; line-height: 1.5; letter-spacing: .01em; color: var(--ink); }
  .chip.accent { background: var(--mint); border-color: var(--mint); color: var(--deep); }
  .rows { display: grid; gap: 2px; }
  .row { border-radius: 8px; }
  .row summary, .row.static { display: grid; grid-template-columns: 36px 1fr auto; align-items: center; gap: 14px; padding: 6px 10px 6px 0; }
  .row summary { cursor: pointer; list-style: none; }
  .row summary::-webkit-details-marker { display: none; }
  .row summary:hover .row-title { text-decoration-color: currentColor; }
  .row summary:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: 8px; }
  .mark { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 9px; background: var(--petrol); color: var(--ice); font-family: var(--font-mono); font-size: 13px; letter-spacing: .02em; }
  .static .mark { background: #dfe6e1; color: var(--petrol); font-size: 10px; }
  .row-text { display: grid; gap: 1px; min-width: 0; }
  .row-title { font-size: 17px; line-height: 1.3; letter-spacing: -.015em; }
  .row-sub { font-size: 14px; line-height: 1.4; color: var(--soft); }
  .chev { font-family: var(--font-mono); font-size: 18px; color: var(--soft); transition: transform .2s; }
  details[open] .chev { transform: rotate(45deg); }
  .row ul { margin: 0 0 8px 50px; padding: 0 0 0 16px; font-size: 14px; line-height: 1.5; color: var(--ink); display: grid; gap: 4px; max-width: 62ch; }
  .row ul li::marker { color: var(--mint); }

  .projects { display: grid; gap: 6px; }
  .proj-card { display: grid; grid-template-columns: 168px 1fr; gap: 18px; align-items: center; padding: 10px; margin-left: -10px; border-radius: 12px; transition: background .2s; }
  .proj-card:hover { background: #ffffff; }
  .proj-card:hover .row-title { text-decoration-color: currentColor; }
  .proj-card:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .thumb { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 8px; border: 1px solid var(--line); background: var(--petrol); }
  .thumb :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: left top; transition: transform .4s; }
  .proj-card:hover .thumb :global(img) { transform: scale(1.04); }
  .project-text { display: grid; gap: 6px; }
  .tagline { font-size: 15px; line-height: 1.4; letter-spacing: -.01em; color: var(--ink); }
  .note { margin-top: 12px; font-size: 12px; color: var(--soft); font-family: var(--font-mono); letter-spacing: .01em; }

  /* ---------- responsive ---------- */
  @media (max-width: 900px) {
    .top { grid-template-columns: 1fr; width: calc(100% - 40px); row-gap: 28px; }
    .lede { align-self: start; font-size: 16px; }
  }
  @media (max-width: 560px) {
    .proj-card { grid-template-columns: 112px 1fr; gap: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .proj-card, .thumb :global(img), .chev { transition: none; }
  }
</style>
