---
import { getCollection, getEntry } from 'astro:content';
import BackgroundTabs from '../components/BackgroundTabs.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import Masthead from '../components/Masthead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const site = await getEntry('site', 'home');
if (!site) {
	throw new Error('Missing src/content/site.yaml entry "home".');
}

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const work = (await getCollection('work')).toSorted(byOrder);
const featured = work[0];
if (!featured) {
	throw new Error('Missing featured work in src/content/work.yaml.');
}
const experience = (await getCollection('experience')).toSorted(byOrder);
const education = (await getCollection('education')).toSorted(byOrder);
---

<BaseLayout title={site.data.documentTitle} description={site.data.description}>
	<Masthead
		name={site.data.name}
		heroLine={site.data.heroLine}
		contact={site.data.contact}
		profileLinks={site.data.profileLinks}
	/>
	<main id="main">
		<FeaturedWork item={featured} />
		<BackgroundTabs roles={experience} degrees={education} about={site.data.about} />
	</main>
</BaseLayout>
