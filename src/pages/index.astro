---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import dashboard from '../assets/tesla-fpa-agent.png';
const site = await getEntry('site', 'home');
if (!site) throw new Error('Missing home content');
const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const work = (await getCollection('work')).toSorted(byOrder);
const roles = (await getCollection('experience')).toSorted(byOrder);
const degrees = (await getCollection('education')).toSorted(byOrder);
const root = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const projectImages = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg,jpeg,webp}', { eager: true });
---
<BaseLayout title="Jacob Kambour — Finance, Analytics & Applied AI" description="MS Finance and Analytics student at Santa Clara University. View projects at the intersection of financial analysis, operations, and applied AI.">
  <Navigation />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid page-width">
        <div class="hero-copy">
          <p class="eyebrow light-label"><span>( JACOB KAMBOUR )</span><span aria-hidden="true">↘</span></p>
          <h1 id="hero-title">FINANCE.<br />ANALYTICS.<br /><span>APPLIED AI.</span></h1>
          <p class="hero-description">MS Finance and Analytics student<br />at Santa Clara University.</p>
          <p class="hero-credentials">Tesla Sales and Delivery Advisor · Former Blendid finance intern.</p>
          <div class="hero-actions">
            <a class="button button-light" href="#work">View projects <span aria-hidden="true">↘</span></a>
            <a class="button button-outline" href="mailto:jkambour@gmail.com">Contact me <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="hero-art">
          <div class="orbital-lines" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="artifact-label"><span class="status-dot"></span> FEATURED PROJECT</div>
          <a class="dashboard-object" href="https://kambourr.github.io/tesla-fpa-agent/" aria-label="Open the live Tesla FP&A Agent dashboard">
            <div class="object-top"><span>01 / TESLA FP&A AGENT</span><span aria-hidden="true">↗</span></div>
            <Image src={dashboard} alt="Tesla FP&A Agent dashboard with reported revenue, historical forecast, and a variance bridge." widths={[640, 960, 1280]} sizes="(max-width: 760px) 90vw, 46vw" loading="eager" fetchpriority="high" />
            <div class="object-bottom"><span>PUBLIC FILINGS → CHECKED COMMENTARY</span><span aria-hidden="true">↗</span></div>
          </a>
          <div class="artifact-caption"><p>Tesla FP&A Agent<br /><em>Historical forecasts and checked commentary.</em></p><a class="text-link light-link" href="https://kambourr.github.io/tesla-fpa-agent/">Open live dashboard <span aria-hidden="true">↗</span></a></div>
        </div>
      </div>
      <div class="hero-bottom page-width"><a href="#work">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a><span>FINANCE × TECHNOLOGY × OPERATIONS</span></div>
    </section>

    <section class="credentials-band" aria-label="Background at a glance">
      <div class="page-width credential-grid">
        <div><span class="eyebrow">( EDUCATION )</span><p>Santa Clara University</p><span>MS Finance and Analytics</span></div>
        <div><span class="eyebrow">( EXPERIENCE )</span><p>Tesla</p><span>Sales and Delivery Advisor</span></div>
        <div><span class="eyebrow">( FINANCE EXPERIENCE )</span><p>Blendid</p><span>Financial Analyst Intern</span></div>
      </div>
    </section>

    <section class="selected-work section-pad page-width" id="work" aria-labelledby="work-title">
      <div class="section-heading"><div><p class="eyebrow">( SELECTED WORK ) <span aria-hidden="true">↘</span></p><h2 id="work-title">Projects</h2></div><p class="section-intro">Personal projects in financial modeling, data analysis, and AI.</p></div>
      {work.map((item, index) => {
        const image = projectImages[`../assets/${item.data.image}`]?.default;
        const projectHref = item.data.caseStudyPath ? `${root}${item.data.caseStudyPath}` : item.data.href;
        return (
        <article class="project" aria-labelledby={`project-${item.id}`}>
          {image && <a href={projectHref} class="project-stage" aria-label={`Explore ${item.data.title}`}>
            <div class="project-stage-top"><span class="eyebrow">( {String(index + 1).padStart(2, '0')} / INDEPENDENT PROJECT )</span><span class="project-live">{item.data.caseStudyPath ? 'READ CASE STUDY' : item.data.hrefLabel} <span aria-hidden="true">↗</span></span></div>
            <div class="project-screenshot"><Image src={image} alt={item.data.imageAlt} widths={[720, 1080, 1440]} sizes="(max-width: 760px) 85vw, 75vw" loading="lazy" /></div>
            <div class="project-stage-bottom"><span>{item.data.title}</span><span class="round-arrow" aria-hidden="true">↗</span></div>
          </a>}
          <div class="project-details"><div><p class="eyebrow project-tags">{item.data.tags.join(' / ')}</p><h3 id={`project-${item.id}`}>{item.data.title}</h3></div><div><p>{item.data.summary}</p><div class="project-links"><a class="text-link" href={projectHref}>Explore project <span aria-hidden="true">↗</span></a><a class="text-link subtle-link" href={item.data.href}>{item.data.hrefLabel} <span aria-hidden="true">↗</span></a></div></div></div>
        </article>
      ); })}
      <div class="work-note"><span aria-hidden="true">↳</span><p>More projects will be added here.</p><a href="https://github.com/Kambourr">Follow on GitHub <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="background-section section-pad" id="background" aria-labelledby="background-title"><div class="page-width">
      <div class="section-heading"><div><p class="eyebrow light-label">( BACKGROUND ) <span aria-hidden="true">↘</span></p><h2 id="background-title">Experience &amp;<br /><span class="muted-light">Education</span></h2></div></div>
      <div class="experience-grid"><div class="background-aside"><p>Experience in financial analysis, sales, and delivery operations.</p><span class="eyebrow">EXPERIENCE / 01—02</span></div><div class="experience-list">
        {roles.map((role, index) => <article class="experience-row"><span class="row-index">0{index + 1}</span><div><div class="role-heading"><h3>{role.data.org}</h3>{role.data.dates && <span class="role-date">{role.data.dates}</span>}</div><p class="role-name">{role.data.title}</p><ul>{role.data.bullets.map(bullet => <li>{bullet}</li>)}</ul></div></article>)}
      </div></div>
      <div class="education-grid"><p class="eyebrow light-label">( EDUCATION )</p><div class="degree-list">{degrees.map(degree => <article><p class="degree-school">{degree.data.school}</p><h3>{degree.data.credential}</h3>{degree.data.dates && <p class="degree-date">{degree.data.dates}</p>}</article>)}</div></div>
    </div></section>

    <section class="about-section section-pad page-width" id="about" aria-labelledby="about-title"><div><p class="eyebrow">( ABOUT ) <span aria-hidden="true">↘</span></p><h2 id="about-title">About me</h2></div><div class="about-copy"><p>{site.data.about}</p><a class="text-link" href="https://www.linkedin.com/in/jacob-kambour-5558a2221/">More on LinkedIn <span aria-hidden="true">↗</span></a></div></section>

    <footer class="contact-section" id="contact"><div class="page-width"><p class="eyebrow">( EMAIL & LINKS )</p><a class="contact-title" href="mailto:jkambour@gmail.com">CONTACT ME.<span aria-hidden="true">↗</span></a><div class="contact-details"><a href="mailto:jkambour@gmail.com">jkambour@gmail.com</a><div><a href="https://www.linkedin.com/in/jacob-kambour-5558a2221/">LinkedIn ↗</a><a href="https://github.com/Kambourr">GitHub ↗</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Jacob Kambour</span><span>FINANCE. ANALYTICS. APPLIED AI.</span><a href="#main">Back to top ↑</a></div></div></footer>
  </main>
</BaseLayout>
