---
/**
 * Homepage — one-screen recruiter page (replaced the Stokt-inspired homepage, Nov 11 2026).
 * Everything a recruiter needs fills the first screen;
 * a role or degree opens on click for the detail. The bottom band is a
 * terminal-style rendering of the real Q3 2026 revenue bridge from the live
 * Tesla FP&A Agent dashboard (figures copied from src/assets/tesla-fpa-agent.png).
 * The old /v2/ draft URL redirects here (astro.config.mjs).
 */
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/jacob-kambour.jpg';

const site = await getEntry('site', 'home');
if (!site) throw new Error('Missing home content');
const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const work = (await getCollection('work')).toSorted(byOrder);
const roles = (await getCollection('experience')).toSorted(byOrder);
const degrees = (await getCollection('education')).toSorted(byOrder);
const root = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg,jpeg,webp}', { eager: true });

const linkedin = site.data.contact.find((c) => c.href.includes('linkedin'))?.href;
const github = site.data.profileLinks.find((l) => l.label === 'GitHub')?.href;
const dashboardUrl = site.data.primaryCta.href;
const monogram: Record<string, string> = { tesla: 'T', blendid: 'B' };

// Q3 2026 revenue bridge, $B, exactly as shown on the live dashboard capture.
type Step = { label: string; short: string; display: string; total?: number; delta?: number };
const steps: Step[] = [
  { label: 'Forecast revenue', short: 'Forecast', display: '$35.53B', total: 35.53 },
  { label: 'Volume', short: 'Volume', display: '−$5.59B', delta: -5.59 },
  { label: 'Price and mix', short: 'Price/mix', display: '−$84M', delta: -0.084 },
  { label: 'Regulatory credits', short: 'Reg. credits', display: '−$10M', delta: -0.01 },
  { label: 'Leasing', short: 'Leasing', display: '+$24M', delta: 0.024 },
  { label: 'Energy generation and storage', short: 'Energy', display: '−$720M', delta: -0.72 },
  { label: 'Services and other', short: 'Services', display: '−$1.10B', delta: -1.1 },
  { label: 'Actual revenue', short: 'Actual', display: '$28.05B', total: 28.05 },
];
const axisMin = 20, axisMax = 40;
const pct = (v: number) => ((v - axisMin) / (axisMax - axisMin)) * 100;
let running = 0;
const bars = steps.map((s, i) => {
  let lo: number, hi: number, kind: string;
  if (s.total !== undefined) { lo = axisMin; hi = s.total; running = s.total; kind = i === 0 ? 'forecast' : 'actual'; }
  else { const start = running; running += s.delta!; lo = Math.min(start, running); hi = Math.max(start, running); kind = s.delta! < 0 ? 'down' : 'up'; }
  return { ...s, kind, bottom: pct(lo), height: pct(hi) - pct(lo) };
});

const tape = [
  'Tesla FP&A Agent', 'Q3 2026', 'Forecast $35.53B', 'Actual $28.05B', 'Variance −$7.48B (−21.1%)',
  '2,495 facts', '63 filings', 'Every figure checked',
  'Delivery Center Estimator', 'ZIP 94402', '$619 per delivery', '5,565 deliveries a year',
  'Standalone NPV $10.75M', '41,034 ZIP codes precomputed', 'Model estimates from public data',
];
---
<BaseLayout title="Jacob Kambour — FP&A, Forecasting, and Financial Modeling" description="Jacob Kambour: current MS in Finance and Analytics student at Santa Clara University, Tesla Sales and Delivery Advisor, and builder of forecasting tools: a Tesla FP&A agent, a delivery center estimator and an Etch spend forecast builder.">
  <main id="main" class="v2">
    <div class="screen">
    <div class="top">
      <header class="intro">
        <div class="id">
          <span class="portrait"><Image src={portrait} alt="Jacob Kambour" widths={[160, 320, 480]} sizes="148px" loading="eager" fetchpriority="high" /></span>
          <div>
            <h1>Jacob Kambour</h1>
            <p class="role">FP&amp;A, forecasting, and financial modeling</p>
            <nav class="links" aria-label="Contact and profiles">
              <a href="mailto:jkambour@gmail.com">Email</a>
              {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>}
              {github && <a href={github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a>}
              <a href={`${root}projects/`}>Project details</a>
            </nav>
          </div>
        </div>
      </header>

      <p class="lede">Current MS in Finance and Analytics student at Santa Clara University, with the MS started during senior year of the BS. At Tesla, I closed about 50 quarter-end deliveries worth over $2 million and ran a mall pop-up foot-traffic study that regional management acted on. On my own, I build the forecasting tools finance teams rely on: a Tesla FP&amp;A agent that ties 361 of 361 figures to filings, a delivery center estimator covering 41,034 ZIP codes, and an Etch spend forecast builder that exports to Excel.</p>

      <section class="col" id="experience" aria-labelledby="edu-title">
        <h2 id="edu-title">Education</h2>
        <div class="rows edu">
          {degrees.map((d) => (
            <div class="row static">
              <span class="mark" aria-hidden="true">SCU</span>
              <span class="row-text">
                <span class="row-title">{d.data.credential}</span>
                <span class="row-sub">{d.data.school}{d.data.dates && <> · {d.data.dates}</>}</span>
                {(d.data.accent || d.data.highlights) && (
                  <span class="chips">
                    {d.data.accent && <span class="chip accent">{d.data.accent}</span>}
                    {d.data.highlights?.map((h) => <span class="chip">{h}</span>)}
                  </span>
                )}
              </span>
            </div>
          ))}
        </div>
        <h2 id="exp-title" class="sub-h">Experience</h2>
        <div class="rows">
          {roles.map((role) => (
            <details class="row" name="v2-detail">
              <summary>
                <span class="mark" aria-hidden="true">{monogram[role.id] ?? role.data.org[0]}</span>
                <span class="row-text"><span class="row-title">{role.data.org}</span><span class="row-sub">{role.data.title}{role.data.dates && <> · {role.data.dates}</>}</span></span>
                <span class="chev" aria-hidden="true">+</span>
              </summary>
              <ul>{role.data.bullets.map((b) => <li>{b}</li>)}</ul>
            </details>
          ))}
        </div>
      </section>

      <section class="col" aria-labelledby="proj-title">
        <h2 id="proj-title">Projects</h2>
        <div class="projects">
          {work.map((item) => {
            const img = images[`../assets/${item.data.image}`]?.default;
            const href = item.data.caseStudyPath ? `${root}${item.data.caseStudyPath}` : item.data.href ?? `${root}projects/`;
            return (
              <a class="proj-card" href={href}>
                {img && <span class="thumb"><Image src={img} alt="" widths={[240, 480]} sizes="200px" loading="eager" /></span>}
                <span class="project-text">
                  <span class="tagline">{item.data.tagline}</span>
                  <span class="row-title">{item.data.title} <span aria-hidden="true">→</span></span>
                </span>
              </a>
            );
          })}
        </div>
        <p class="note">Independent projects using public data or illustrative numbers. Not affiliated with or endorsed by Tesla or Applied Materials.</p>
      </section>
    </div>
    <a class="scroll-cue" href="#bridge">Tesla FP&amp;A Agent revenue bridge <span aria-hidden="true">↓</span></a>
    </div>

    <section class="terminal" id="bridge" aria-labelledby="term-title">
      <div class="term-inner">
        <div class="term-head">
          <h2 id="term-title"><span class="prompt" aria-hidden="true">&gt;</span> Tesla FP&amp;A Agent · Revenue bridge · Q3 2026<span class="cursor" aria-hidden="true"></span></h2>
          <a class="term-link" href={dashboardUrl} target="_blank" rel="noopener noreferrer">Open dashboard <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
        </div>

        <div class="term-body">
          <figure class="bridge">
            <div class="plot" role="img" aria-label="Waterfall chart: forecast revenue $35.53B, volume −$5.59B, price and mix −$84M, regulatory credits −$10M, leasing +$24M, energy generation and storage −$720M, services and other −$1.10B, actual revenue $28.05B. Axis starts at $20B.">
              <div class="grid" aria-hidden="true">{[40, 35, 30, 25, 20].map((v) => <span data-v={`$${v}B`}></span>)}</div>
              {bars.map((b, i) => (
                <div class={`bar-col ${b.kind}`} style={`--i:${i}`}>
                  <span class="bar" style={`bottom:${b.bottom}%;height:max(${b.height}%,3px)`}></span>
                  <span class="val" style={`bottom:calc(${b.bottom + b.height}% + 6px)`}>{b.display}</span>
                </div>
              ))}
            </div>
            <div class="labels" aria-hidden="true">{bars.map((b) => <span>{b.short}</span>)}</div>
            <figcaption>Historical backtest from public SEC filings. The axis starts at $20B so the drivers are visible.</figcaption>
          </figure>

          <dl class="readout">
            <div class="big"><dt>Variance, forecast vs. actual</dt><dd>−$7.48B<small>−21.1% unfavorable</small></dd></div>
            <div class="pair"><dt>Forecast</dt><dd>$35.53B</dd></div>
            <div class="pair"><dt>Actual</dt><dd>$28.05B</dd></div>
            <div class="meta"><dt class="sr-only">Run</dt><dd>2,495 facts · 63 filings · every figure checked</dd></div>
          </dl>
        </div>
      </div>

      <div class="tape" aria-label="Project figures">
        <ul class="tape-track">
          {tape.map((t) => <li>{t}</li>)}
          {tape.map((t) => <li aria-hidden="true">{t}</li>)}
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .v2 {
    --cream: #f2f1ea; --ink: #102d30; --soft: #526668; --line: #ccd4d0;
    --petrol: #092f33; --deep: #071e22; --mint: #9bd4c2; --ice: #c8e6dc;
    --amber: #e3b062; --up: #acdfc9; --t-line: #1d4a4e;
    background: var(--cream); color: var(--ink);
  }
  /* The first screen holds only the recruiter content; the terminal band starts below the fold. */
  .screen { min-height: 100svh; display: flex; flex-direction: column; }
  .screen > .top { margin-block: auto; }
  .scroll-cue { align-self: center; display: inline-flex; gap: 10px; align-items: center; margin: 8px 0 clamp(16px, 3vh, 28px); padding: 8px 12px; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--soft); border-radius: 6px; transition: color .2s; }
  .scroll-cue:hover { color: var(--ink); }
  .scroll-cue:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .scroll-cue span { animation: nudge 1.8s ease-in-out infinite; }
  @keyframes nudge { 50% { transform: translateY(3px); } }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* ---------- top: identity, experience, projects ---------- */
  .top {
    width: min(1180px, calc(100% - 96px)); margin-inline: auto; padding: clamp(22px, 3.8vh, 52px) 0 clamp(16px, 2.4vh, 32px);
    display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(48px, 7vw, 112px); row-gap: clamp(18px, 2.8vh, 32px); align-items: start;
  }
  .id { display: flex; align-items: center; gap: clamp(16px, 2vw, 26px); }
  .portrait { flex: none; width: clamp(96px, 10vw, 148px); aspect-ratio: 1; display: block; overflow: hidden; border-radius: 18px; border: 1px solid var(--line); background: var(--petrol); box-shadow: 0 14px 36px #092f3326; }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 24%; }
  h1 { margin-top: 0; font-size: clamp(44px, 5.2vw, 68px); line-height: 1; letter-spacing: -.045em; }
  .role { margin-top: 10px; font-size: 19px; letter-spacing: -.02em; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 16px; font-size: 15px; }
  .links a, .proj-card .row-title, .row-title { text-decoration: underline; text-decoration-color: #102d3055; text-underline-offset: 4px; text-decoration-thickness: 1px; transition: text-decoration-color .2s, color .2s; }
  .links a:hover { text-decoration-color: currentColor; }
  .lede { align-self: center; max-width: 54ch; font-size: 17px; line-height: 1.55; color: var(--ink); padding-bottom: 4px; border-left: 2px solid var(--mint); padding-left: 18px; }

  .col h2 { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--soft); margin-bottom: 10px; }
  .col .sub-h { margin-top: clamp(16px, 2.4vh, 24px); }
  .edu .row-title { font-size: 18px; }
  .edu .row.static { align-items: start; padding-block: 8px; }
  .edu .mark { margin-top: 3px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .chip { padding: 3px 9px; border-radius: 6px; border: 1px solid var(--line); background: #ffffff; font-family: var(--font-mono); font-size: 11px; line-height: 1.5; letter-spacing: .01em; color: var(--ink); }
  .chip.accent { background: var(--mint); border-color: var(--mint); color: var(--deep); }
  .rows { display: grid; gap: 2px; }
  .row { border-radius: 8px; }
  .row summary, .row.static { display: grid; grid-template-columns: 36px 1fr auto; align-items: center; gap: 14px; padding: 6px 10px 6px 0; }
  .row summary { cursor: pointer; list-style: none; }
  .row summary::-webkit-details-marker { display: none; }
  .row summary:hover .row-title { text-decoration-color: currentColor; }
  .row summary:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: 8px; }
  .mark { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 9px; background: var(--petrol); color: var(--ice); font-family: var(--font-mono); font-size: 13px; letter-spacing: .02em; }
  .static .mark { background: #dfe6e1; color: var(--petrol); font-size: 10px; }
  .row-text { display: grid; gap: 1px; min-width: 0; }
  .row-title { font-size: 17px; line-height: 1.3; letter-spacing: -.015em; }
  .row-sub { font-size: 14px; line-height: 1.4; color: var(--soft); }
  .chev { font-family: var(--font-mono); font-size: 18px; color: var(--soft); transition: transform .2s; }
  details[open] .chev { transform: rotate(45deg); }
  .row ul { margin: 0 0 8px 50px; padding: 0 0 0 16px; font-size: 14px; line-height: 1.5; color: var(--ink); display: grid; gap: 4px; max-width: 62ch; }
  .row ul li::marker { color: var(--mint); }

  .projects { display: grid; gap: 6px; }
  .proj-card { display: grid; grid-template-columns: 168px 1fr; gap: 18px; align-items: center; padding: 10px; margin-left: -10px; border-radius: 12px; transition: background .2s; }
  .proj-card:hover { background: #ffffff; }
  .proj-card:hover .row-title { text-decoration-color: currentColor; }
  .proj-card:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .thumb { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 8px; border: 1px solid var(--line); background: var(--petrol); }
  .thumb :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: left top; transition: transform .4s; }
  .proj-card:hover .thumb :global(img) { transform: scale(1.04); }
  .project-text { display: grid; gap: 6px; }
  .tagline { font-size: 15px; line-height: 1.4; letter-spacing: -.01em; color: var(--ink); }
  .note { margin-top: 12px; font-size: 12px; color: var(--soft); font-family: var(--font-mono); letter-spacing: .01em; }

  /* ---------- terminal band ---------- */
  .terminal {
    display: flex; flex-direction: column; position: relative; isolation: isolate;
    background: var(--deep); color: var(--ice); font-family: var(--font-mono); border-top: 1px solid var(--t-line);
  }
  .terminal::before { /* faint scanlines */
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse at 30% 0%, #1d5a5440, transparent 60%), repeating-linear-gradient(0deg, #ffffff05 0 1px, transparent 1px 3px);
  }
  .term-inner { width: min(1180px, calc(100% - 96px)); margin-inline: auto; padding: clamp(40px, 6vh, 64px) 0 clamp(32px, 5vh, 48px); display: flex; flex-direction: column; }
  .term-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .term-head h2 { font-size: 12px; font-weight: 400; text-transform: uppercase; letter-spacing: .08em; color: var(--mint); }
  .prompt { color: var(--amber); margin-right: 6px; }
  .cursor { display: inline-block; width: .6em; height: 1.05em; margin-left: 6px; vertical-align: -2px; background: var(--mint); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .term-link { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--deep); background: var(--ice); padding: 10px 14px; border-radius: 6px; transition: background .2s; }
  .term-link:hover { background: #ffffff; }
  .term-link:focus-visible { outline: 2px solid var(--ice); outline-offset: 3px; }

  .term-body { flex: 1; display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(220px, 1fr); gap: clamp(28px, 5vw, 72px); align-items: end; margin-top: clamp(24px, 3.4vh, 36px); }
  .bridge { display: grid; grid-template-rows: 1fr auto auto; height: 100%; min-height: 280px; }
  .plot { position: relative; display: grid; grid-template-columns: repeat(8, 1fr); gap: clamp(6px, 1vw, 14px); padding-left: 44px; min-height: 200px; margin-top: 18px; }
  .grid { position: absolute; inset: 0 0 0 44px; display: flex; flex-direction: column; justify-content: space-between; pointer-events: none; }
  .grid span { position: relative; border-top: 1px dashed var(--t-line); height: 0; }
  .grid span::before { content: attr(data-v); position: absolute; right: calc(100% + 8px); top: -7px; font-size: 10px; color: #6f9590; }
  .bar-col { position: relative; }
  .bar { position: absolute; left: 0; right: 0; animation: rise .9s steps(9, end) both; animation-delay: calc(var(--i) * 110ms + 150ms); }
  .forecast .bar { background: repeating-linear-gradient(90deg, var(--mint) 0 4px, #9bd4c2aa 4px 6px); }
  .actual .bar { background: repeating-linear-gradient(90deg, var(--ice) 0 4px, #c8e6dcbb 4px 6px); }
  .down .bar { background: repeating-linear-gradient(0deg, var(--amber) 0 3px, #e3b06299 3px 4px); }
  .up .bar { background: var(--up); }
  .val { position: absolute; left: 50%; translate: -50% 0; white-space: nowrap; font-size: clamp(10px, .85vw, 12px); color: var(--ice); }
  .down .val { color: var(--amber); }
  .up .val { color: var(--up); }
  @keyframes rise { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  .labels { display: grid; grid-template-columns: repeat(8, 1fr); gap: clamp(6px, 1vw, 14px); padding-left: 44px; margin-top: 8px; font-size: 10px; text-transform: uppercase; letter-spacing: .03em; color: #8fb3ad; text-align: center; }
  .bridge figcaption { margin-top: 10px; font-size: 11px; color: #6f9590; }

  .readout { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; align-self: center; }
  .readout div { border-top: 1px solid var(--t-line); padding-top: 10px; }
  .readout dt { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: #8fb3ad; }
  .readout dd { margin: 4px 0 0; font-family: var(--font-sans), sans-serif; font-size: clamp(18px, 1.6vw, 22px); letter-spacing: -.02em; color: var(--cream); }
  .readout .pair { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding-top: 8px; }
  .readout .pair dd { margin: 0; }
  .readout .big { grid-column: 1 / -1; }
  .readout .big dd { font-family: var(--font-sans), sans-serif; font-weight: 500; font-size: clamp(40px, 4.2vw, 60px); line-height: 1; letter-spacing: -.035em; color: var(--amber); }
  .readout .big small { display: block; margin-top: 6px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .04em; color: #c9a36b; }
  .readout .meta { grid-column: 1 / -1; }
  .readout .meta dd { font-family: var(--font-mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--mint); }

  .tape { border-top: 1px solid var(--t-line); overflow: hidden; background: #051619; }
  .tape-track { display: flex; width: max-content; margin: 0; padding: 0; list-style: none; animation: tape 60s linear infinite; }
  .tape:hover .tape-track { animation-play-state: paused; }
  .tape li { padding: 10px 0; font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: #8fb3ad; white-space: nowrap; }
  .tape li::after { content: '·'; margin: 0 16px; color: var(--amber); }
  @keyframes tape { to { transform: translateX(-50%); } }

  /* ---------- responsive ---------- */
  @media (max-width: 900px) {
    .top { grid-template-columns: 1fr; width: calc(100% - 40px); row-gap: 28px; }
    .lede { align-self: start; font-size: 16px; }
    .term-inner { width: calc(100% - 40px); }
    .term-body { grid-template-columns: 1fr; }
    .bridge { min-height: 230px; }
  }
  @media (max-width: 560px) {
    .proj-card { grid-template-columns: 112px 1fr; gap: 14px; }
    .plot, .labels { gap: 4px; padding-left: 36px; }
    .plot { margin-top: 64px; }
    .grid { left: 36px; }
    .val { font-size: 9px; writing-mode: vertical-rl; rotate: 180deg; translate: -50% 0; }
    .labels span { writing-mode: vertical-rl; rotate: 180deg; justify-self: center; height: 64px; text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar, .cursor { animation: none; }
    .tape-track { animation: none; width: auto; flex-wrap: wrap; padding: 6px 20px; }
    .tape-track li[aria-hidden] { display: none; }
    .proj-card, .thumb :global(img), .chev, .scroll-cue { transition: none; }
    .scroll-cue span { animation: none; }
  }
</style>
