---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ContactFooter from '../components/ContactFooter.astro';
import '../styles/scrollcraft-portfolio.css';
import dashboard from '../assets/tesla-fpa-agent.png';
import estimator from '../assets/delivery-center-estimator.png';
const site = await getEntry('site', 'home');
if (!site) throw new Error('Missing home content');
const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const work = (await getCollection('work')).toSorted(byOrder);
const roles = (await getCollection('experience')).toSorted(byOrder);
const degrees = (await getCollection('education')).toSorted(byOrder);
const root = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const projectImages = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg,jpeg,webp}', { eager: true });
---
<BaseLayout title="Jacob Kambour — Finance, Analytics & Applied AI" description="MS Finance and Analytics student at Santa Clara University. View projects at the intersection of financial analysis, operations, and applied AI.">
  <Navigation />
  <main id="main">
    <section class="hero" data-sc-act="flow" aria-labelledby="hero-title">
      <div class="hero-grid page-width">
        <div class="hero-copy">
          <p class="eyebrow light-label"><span>( JACOB KAMBOUR )</span><span aria-hidden="true">↘</span></p>
          <h1 id="hero-title">FINANCE.<br />ANALYTICS.<br /><span>APPLIED AI.</span></h1>
          <p class="hero-description">MS Finance and Analytics student<br />at Santa Clara University.</p>
          <p class="hero-credentials">Tesla Sales and Delivery Advisor · Former Blendid finance intern.</p>
          <div class="hero-actions">
            <a class="button button-light" href="#work">View projects <span aria-hidden="true">↘</span></a>
            <a class="button button-outline" href="mailto:jkambour@gmail.com">Contact me <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="hero-art">
          <div class="orbital-lines" data-sc-parallax="0.18" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="artifact-label"><span class="status-dot"></span> SELECTED PROJECTS</div>
          <div class="dashboard-plane" data-sc-parallax="-0.28"><a class="dashboard-object" href={`${root}work/tesla-fpa-agent/`} target="_blank" rel="noopener noreferrer" aria-label="Tesla FP&A Agent case study">
            <div class="object-top"><span>TESLA FP&A AGENT</span><span aria-hidden="true">↗</span></div>
            <Image src={dashboard} alt="Tesla FP&A Agent dashboard with reported revenue, historical forecast, and a variance bridge." widths={[640, 960, 1280]} sizes="(max-width: 760px) 90vw, 46vw" loading="eager" fetchpriority="high" />
          </a></div>
          <div class="estimator-plane" data-sc-parallax="-0.5"><a class="dashboard-object estimator-object" href={`${root}work/delivery-center-estimator/`} target="_blank" rel="noopener noreferrer" aria-label="Delivery Center Estimator case study">
            <div class="object-top"><span>DELIVERY CENTER ESTIMATOR</span><span aria-hidden="true">↗</span></div>
            <Image src={estimator} alt="Delivery Center Estimator app with a ZIP code map and its cost-per-delivery dashboard." widths={[480, 720, 960]} sizes="(max-width: 760px) 70vw, 24vw" loading="eager" />
          </a></div>
        </div>
      </div>
      <div class="hero-bottom page-width"><span>FINANCE × TECHNOLOGY × OPERATIONS</span></div>
    </section>

    <section class="credentials-band" aria-label="Background at a glance">
      <div class="page-width credential-grid">
        <div><span class="eyebrow">( EDUCATION )</span><p>Santa Clara University</p><span>MS Finance and Analytics</span></div>
        <div><span class="eyebrow">( EXPERIENCE )</span><p>Tesla</p><span>Sales and Delivery Advisor</span></div>
        <div><span class="eyebrow">( FINANCE EXPERIENCE )</span><p>Blendid</p><span>Financial Analyst Intern</span></div>
      </div>
    </section>

    <section class="selected-work section-pad page-width" id="work" aria-labelledby="work-title">
      <div class="section-heading"><div><h2 id="work-title">Projects</h2></div><div class="section-aside"><p class="section-intro">Personal projects in financial modeling, data analysis, and AI.</p><a class="text-link" href={`${root}projects/`}>View project details <span aria-hidden="true">→</span></a></div></div>
      <div class="project-cards">
        {work.map((item) => {
          const image = projectImages[`../assets/${item.data.image}`]?.default;
          const projectHref = item.data.caseStudyPath ? `${root}${item.data.caseStudyPath}` : item.data.href ?? `${root}projects/`;
          return (
          <article class="project-card" aria-labelledby={`card-${item.id}`}>
            <a class="project-card-link" href={projectHref} target="_blank" rel="noopener noreferrer">
              {image && <div class="project-card-media"><div class="project-card-frame"><Image src={image} alt="" widths={[560, 840, 1120]} sizes="(max-width: 760px) calc(100vw - 40px), 44vw" loading="lazy" /></div></div>}
              <div class="project-card-body">
                <h3 id={`card-${item.id}`}>{item.data.title}</h3>
                <p>{item.data.tagline}</p>
                <span class="project-card-cta">{item.data.caseStudyPath ? 'Read case study' : item.data.hrefLabel ?? 'View project'} <span aria-hidden="true">↗</span></span>
              </div>
            </a>
          </article>
        ); })}
      </div>
      <div class="work-note"><span aria-hidden="true">↳</span><p>More projects will be added here.</p><a href="https://github.com/Kambourr" target="_blank" rel="noopener noreferrer">Follow on GitHub <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="background-section section-pad" id="background" aria-labelledby="background-title"><div class="page-width">
      <div class="section-heading"><div><h2 id="background-title">Experience &amp;<br /><span class="muted-light">Education</span></h2></div></div>
      <div class="experience-grid"><div class="background-aside"><p>Experience in financial analysis, sales, and delivery operations.</p></div><div class="experience-list">
        {roles.map((role, index) => <article class="experience-row"><span class="row-index">0{index + 1}</span><div><div class="role-heading"><h3>{role.data.org}</h3>{role.data.dates && <span class="role-date">{role.data.dates}</span>}</div><p class="role-name">{role.data.title}</p><ul>{role.data.bullets.map(bullet => <li>{bullet}</li>)}</ul></div></article>)}
      </div></div>
      <div class="education-grid"><p class="eyebrow light-label">( EDUCATION )</p><div class="degree-list">{degrees.map(degree => <article><p class="degree-school">{degree.data.school}</p><h3>{degree.data.credential}</h3>{degree.data.dates && <p class="degree-date">{degree.data.dates}</p>}</article>)}</div></div>
    </div></section>

    <section class="about-section section-pad page-width" id="about" aria-labelledby="about-title"><div><h2 id="about-title">About me</h2></div><div class="about-copy"><p>{site.data.about}</p><a class="text-link" href="https://www.linkedin.com/in/jacob-kambour-5558a2221/" target="_blank" rel="noopener noreferrer">More on LinkedIn <span aria-hidden="true">↗</span></a></div></section>

    <ContactFooter />
  </main>
  <script>
    import '../vendor/scrollcraft/scrollcraft.js';
    const craft = (window as unknown as { ScrollCraft: { mount: (root: HTMLElement) => void } }).ScrollCraft;
    const main = document.querySelector<HTMLElement>('main');
    if (main && craft) craft.mount(main);
  </script>
</BaseLayout>
